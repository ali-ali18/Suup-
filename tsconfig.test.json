{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/test/**/*.ts",
    "evals/src/**/*.test.ts",
    "evals/test/**/*.ts"
  ],
  "exclude": ["apps/desktop"]
}
