{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "paths": {
      "@suup/api": ["../../packages/api/src/index.ts"],
      "@suup/avatar": ["../../packages/avatar/src/index.ts"],
      "@suup/avatar/browser": ["../../packages/avatar/src/browser.ts"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
