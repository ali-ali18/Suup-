# Variáveis do docker-compose.prod.yml. Copie para .env.prod, preencha e proteja o arquivo
# (chmod 600 .env.prod). NUNCA versione o .env.prod: ele guarda segredos.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Guia completo: docs/IMPLANTACAO.md

# --- Postgres ---------------------------------------------------------------------------------
POSTGRES_USER=suup
# Use só letras e números (vai dentro de uma URL): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=suup

# --- Servidor ---------------------------------------------------------------------------------
# Token do app (mínimo 32 caracteres). Gere com:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm --no-deps server server --generate-token
# (ou, sem Docker, openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
SUUP_SERVER_TOKEN=
# Porta no host, só em 127.0.0.1 (o proxy com TLS fica na frente). Dentro do contêiner é sempre 8787.
SUUP_PORT=8787

# --- Worker -----------------------------------------------------------------------------------
# Grupo dono do socket do Docker no host (o worker precisa dele para falar com a máquina dos bots):
#   stat -c %g /var/run/docker.sock
DOCKER_GID=

# --- Chaves dos provedores de modelo (só os nomes que o suup.config.json usa em apiKeyEnv) -----
ANTHROPIC_API_KEY=
