{
  "databaseUrl": "postgres://suup:suup@127.0.0.1:5432/suup",
  "providers": [
    {
      "id": "anthropic",
      "kind": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    },
    {
      "id": "local",
      "kind": "openai-compatible",
      "baseUrl": "http://127.0.0.1:11434/v1"
    }
  ],
  "models": [
    {
      "id": "model-x",
      "name": "Modelo X",
      "provider": "anthropic",
      "contextWindow": 200000,
      "maxOutputTokens": 8192,
      "pricing": { "inputPerMTok": 3, "outputPerMTok": 15, "cachedInputPerMTok": 0.3 }
    },
    {
      "id": "model-y",
      "name": "Modelo Y",
      "provider": "local",
      "contextWindow": 32000,
      "maxOutputTokens": 4096
    }
  ],
  "reviewer": { "model": "model-x" },
  "memory": { "consolidation": { "model": "model-x" } },
  "sandbox": {
    "kind": "docker",
    "image": "suup-sandbox:dev",
    "name": "suup-machine",
    "volume": "suup-workspace",
    "memory": "2g",
    "cpus": 2,
    "network": { "defaultHosts": ["registry.npmjs.org", "pypi.org", "files.pythonhosted.org"] },
    "connectors": { "image": "suup-connector-runner:dev" }
  },
  "web": {
    "search": {
      "engines": ["wikipedia", "arxiv", "stackoverflow", "tavily", "brave"],
      "general": { "order": ["tavily", "brave"] }
    },
    "reader": { "image": "suup-reader:dev" }
  },
  "worker": { "concurrency": 4, "leaseRenewMs": 10000, "staleAfterMs": 30000 },
  "defaults": { "maxTurns": 50, "maxCostUsd": 2, "maxDurationMs": 1800000 }
}
