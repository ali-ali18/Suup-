{
  "name": "suup",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/desktop/tsconfig.json",
    "test": "vitest run",
    "suup": "tsc -b apps/cli && node --env-file-if-exists=.env apps/cli/dist/bin.js",
    "release:version": "node apps/desktop/scripts/release-version.mjs",
    "db:migrate": "tsc -b packages/db && node --env-file-if-exists=.env packages/db/dist/migrate-cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
