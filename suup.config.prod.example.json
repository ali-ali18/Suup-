{
  "providers": [
    {
      "id": "anthropic",
      "kind": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    }
  ],
  "models": [
    {
      "id": "model-x",
      "provider": "anthropic",
      "contextWindow": 200000,
      "maxOutputTokens": 8192,
      "pricing": { "inputPerMTok": 3, "outputPerMTok": 15, "cachedInputPerMTok": 0.3 }
    }
  ],
  "reviewer": { "model": "model-x" },
  "memory": { "consolidation": { "model": "model-x" } },
  "sandbox": {
    "kind": "docker",
    "image": "suup-sandbox:prod",
    "name": "suup-machine",
    "volume": "suup-workspace",
    "memory": "2g",
    "cpus": 2,
    "network": {
      "name": "suup-sandbox-net",
      "defaultHosts": ["registry.npmjs.org", "pypi.org", "files.pythonhosted.org"],
      "proxy": { "listenHost": "172.29.77.2", "advertiseHost": "172.29.77.2", "port": 3128 }
    },
    "connectors": { "image": "suup-connector-runner:prod" }
  },
  "web": {
    "search": {
      "engines": ["wikipedia", "arxiv", "stackoverflow", "github"],
      "network": "suup-search-net",
      "proxy": { "listenHost": "172.29.78.2", "advertiseHost": "172.29.78.2", "port": 3129 }
    },
    "reader": { "image": "suup-reader:prod" }
  },
  "worker": {
    "concurrency": 4,
    "leaseRenewMs": 10000,
    "staleAfterMs": 30000,
    "controlPollMs": 2000
  },
  "defaults": { "maxTurns": 50, "maxCostUsd": 2, "maxDurationMs": 1800000 },
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "allowedOrigins": ["tauri://localhost", "http://tauri.localhost", "https://tauri.localhost"],
    "tokenEnv": "SUUP_SERVER_TOKEN"
  }
}
